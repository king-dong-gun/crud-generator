{
  "info": {
    "_postman_id": "c7c7fad2-406d-485d-8d32-bdf2d462ceca",
    "name": "CRUD Generator",
    "description": "util/crudgen 을 넣은 내 프로젝트를 실행한 뒤 사용합니다. Variables 의 baseUrl 을 내 프로젝트 주소로 바꾸세요.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 코드 생성",
      "item": [
        {
          "name": "1-1. member 생성",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/generate/write"
            },
            "body": {
              "mode": "raw",
              "raw": "CREATE TABLE member (\n  member_id BIGINT NOT NULL AUTO_INCREMENT,\n  name      VARCHAR(50) NOT NULL,\n  phone     VARCHAR(20),\n  PRIMARY KEY (member_id)\n);",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "description": "Body(raw → Text)에 CREATE TABLE 문. 200 이면 files 에 만들어진 파일 목록이 옵니다."
          }
        },
        {
          "name": "1-2. 다시 생성 (overwrite=true)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/generate/write?overwrite=true"
            },
            "body": {
              "mode": "raw",
              "raw": "CREATE TABLE member (\n  member_id BIGINT NOT NULL AUTO_INCREMENT,\n  name      VARCHAR(50) NOT NULL,\n  phone     VARCHAR(20),\n  PRIMARY KEY (member_id)\n);",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "description": "이미 있는 파일을 덮어씁니다. 직접 고친 내용은 사라집니다."
          }
        },
        {
          "name": "1-3. Oracle DDL, Lombok 없이 (lombok=false)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/generate/write?lombok=false"
            },
            "body": {
              "mode": "raw",
              "raw": "CREATE TABLE BOARD (\n    BOARD_NO   NUMBER(10) GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n    TITLE      VARCHAR2(200) NOT NULL,\n    CONTENT    CLOB,\n    VIEW_COUNT NUMBER(5) DEFAULT 0 NOT NULL,\n    REG_DATE   DATE DEFAULT SYSDATE\n)",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "1-A. 다른 프로젝트에 생성 (복사 없이)",
      "item": [
        {
          "name": "member 를 projectPath 프로젝트에 생성",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "CREATE TABLE member (\n  member_id BIGINT NOT NULL AUTO_INCREMENT,\n  name      VARCHAR(50) NOT NULL,\n  phone     VARCHAR(20),\n  PRIMARY KEY (member_id)\n);",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/generate/write?projectPath={{projectPath}}"
            },
            "description": "이 저장소의 DemoApplication 을 실행해 두고 사용합니다. Variables 의 projectPath 를 대상 프로젝트(build.gradle 이 있는 폴더) 절대 경로로 바꾸세요."
          }
        }
      ]
    },
